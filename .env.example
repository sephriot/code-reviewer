# GitHub
GITHUB_TOKEN=
GITHUB_USERNAME=

# Review tool: CLAUDE, CODEX, or AGENT
REVIEW_TOOL=CLAUDE
# Claude model: opus, sonnet, fable
CLAUDE_MODEL=
# Path to review prompt file
PROMPT_FILE=prompts/review_prompt.txt

# App
POLL_INTERVAL=60
REVIEW_TIMEOUT=900
LOG_LEVEL=INFO
DRY_RUN=false
SHOW_THINKING=false
ATLAS_ENABLED=false

# DB
DATABASE_PATH=data/reviews.db

# Filters (comma-separated, supports regex)
# REPOSITORIES=owner/repo1,owner/repo2
# PR_AUTHORS=user1,user2

# Own PR mode: off, auto, manual
OWN_PR_MODE=off

# Web UI
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Notifications — TTS (say:...) or audio file path
SOUND_ENABLED=true
STARTUP_SOUNDS_ENABLED=false
SPEECH_RATE=200

# SOUND_FILE="say:New review request for PR {title} in {repo} by {author}"
# APPROVAL_SOUND_FILE="say:PR {title} in {repo} approved"
# TIMEOUT_SOUND_FILE=sounds/review_failed.mp3
# HUMAN_REVIEW_SOUND_FILE="say:PR {title} in {repo} needs human review"
# REVIEW_STARTED_SOUND_FILE="say:Review started for PR {title} in {repo}"
# MERGED_OR_CLOSED_SOUND_FILE="say:PR {title} in {repo} merged or closed"
# OWN_PR_READY_SOUND_FILE="say:Your PR {title} in {repo} is ready"
# OWN_PR_NEEDS_ATTENTION_SOUND_FILE="say:Your PR {title} in {repo} needs attention"
