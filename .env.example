# ─── GitHub ───────────────────────────────────────────
# GitHub personal access token with repo scope
GITHUB_TOKEN=
# Your GitHub username (used to find assigned PRs)
GITHUB_USERNAME=

# ─── Review tool ──────────────────────────────────────
# Which CLI to invoke: CLAUDE, CODEX, or AGENT
REVIEW_TOOL=CLAUDE
# Claude model alias passed as --model (opus / sonnet / fable)
CLAUDE_MODEL=
# Path to the review prompt file (read and fed to the tool)
PROMPT_FILE=prompts/review_prompt.txt

# ─── App behaviour ────────────────────────────────────
# How often to scan GitHub for new/updated PRs (seconds)
POLL_INTERVAL=60
# Max time a single review run is allowed (seconds)
REVIEW_TIMEOUT=900
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
# When true, log intended actions without executing them
DRY_RUN=false
# Stream Claude/Agent thinking to stdout
SHOW_THINKING=false
# Enable Atlas knowledge retrieval (requires Atlas MCP)
ATLAS_ENABLED=false

# ─── Database ─────────────────────────────────────────
# SQLite file path (auto-created, auto-migrated on startup)
DATABASE_PATH=data/reviews.db

# ─── Filters ──────────────────────────────────────────
# Comma-separated repo patterns (owner/repo or owner/* regex)
# REPOSITORIES=owner/repo1,owner/repo2
# Comma-separated author usernames (plain or regex)
# PR_AUTHORS=user1,user2

# ─── Own PRs ──────────────────────────────────────────
# off = ignore own PRs, auto = review automatically, manual = list in UI, review on demand
OWN_PR_MODE=off

# ─── Web UI ───────────────────────────────────────────
# Enable the web dashboard
WEB_ENABLED=true
# Host to bind to (0.0.0.0 for network access)
WEB_HOST=127.0.0.1
# Port for the web UI
WEB_PORT=8000

# ─── Notifications ────────────────────────────────────
# Master toggle for all sound/voice notifications
SOUND_ENABLED=true
# Play startup demo sounds
STARTUP_SOUNDS_ENABLED=false
# macOS say speech rate (words per minute)
SPEECH_RATE=200

# Per-event sound templates. Prefix with say: for TTS,
# or use a path to an audio file (.mp3 / .wav) for afplay.
# Available placeholders: {repo}, {pr_number}, {title}, {author}
#
# SOUND_FILE="say:New review request for PR {title} in {repo} by {author}"
# APPROVAL_SOUND_FILE="say:PR {title} in {repo} approved"
# TIMEOUT_SOUND_FILE=sounds/review_failed.mp3
# HUMAN_REVIEW_SOUND_FILE="say:PR {title} in {repo} needs human review"
# REVIEW_STARTED_SOUND_FILE="say:Review started for PR {title} in {repo}"
# MERGED_OR_CLOSED_SOUND_FILE="say:PR {title} in {repo} merged or closed"
# OWN_PR_READY_SOUND_FILE="say:Your PR {title} in {repo} is ready"
# OWN_PR_NEEDS_ATTENTION_SOUND_FILE="say:Your PR {title} in {repo} needs attention"
